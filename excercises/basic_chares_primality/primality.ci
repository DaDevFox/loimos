mainmodule PrimalityModule {
  readonly CProxy_Main mainProxy;

  message PrimalityTaskMsg {
    unsigned long requestId;
    unsigned long long value;
  };

  message PrimalityBatchMsg {
    unsigned long requestIdBase;
    unsigned int count;
    unsigned long long values[];
  };

  message PrimalityResultMsg {
    unsigned long requestId;
    unsigned long long value;
    int isPrime;
  };

  mainchare Main {
    entry Main(CkArgMsg *msg);
    entry void receiveResult(PrimalityResultMsg *msg);
  };

  array [1D] CheckPrimality {
    entry CheckPrimality();
    entry void testNumber(PrimalityTaskMsg *msg);
    entry void testBatch(PrimalityBatchMsg *msg);
  };
}
